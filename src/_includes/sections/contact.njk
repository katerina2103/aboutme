{% set c = site.contact %}
<section id="connect" class="band band--light">
  <div class="band__inner band__inner--end">
    <div data-reveal style="--i: 0">
      <h2 class="contact__title">{{ c.title | mdInline | safe }}</h2>
      <div class="contact__text">{{ c.body | md | safe }}</div>
      <div class="contact__actions">
      <a class="btn btn--solid" href="{{ c.button.link }}">{{ c.button.label }}</a>
      {% if c.location_line %}<span class="contact__meta">{{ c.location_line }}</span>{% endif %}
      </div>
    </div>
    {% if site.about.testimonial %}
    <div class="colleague-note-wrap" data-reveal style="--i: 1">
      <figure class="colleague-note sticky" style="--tilt: -1.5deg" aria-label="A note from a former colleague">
        <blockquote><p>“{{ site.about.testimonial.quote }}”</p></blockquote>
        <figcaption>— {{ site.about.testimonial.attribution }}</figcaption>
      </figure>
    </div>
    {% endif %}
  </div>
</section>

