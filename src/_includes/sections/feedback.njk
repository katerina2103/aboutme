<section class="site-feedback site-feedback--quiet" aria-labelledby="feedback-title">
<div class="feedback-quiet-row"><div class="feedback-quiet-copy">
<h2 id="feedback-title">{{ site.feedback.copy.i_treat_this_website_as_a_product }}</h2></div>
<div class="feedback-votes" role="group" aria-label="{{ site.feedback.copy.has_this_website_given_you_a_sense }}">
<button type="button" data-vote="up">{{ site.feedback.copy.label }}<span>{{ site.feedback.copy.yes_clearly }}</span></button><button type="button" data-vote="down">{{ site.feedback.copy.label_2 }}<span>{{ site.feedback.copy.not_quite_yet }}</span></button>
</div></div>
<p class="feedback-status" role="status" aria-live="polite"></p>

</section>