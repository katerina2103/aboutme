{# Overlay with the full list of principles. Opened by the "Explore my … principles" link.
   Uses the native <dialog> element: Esc closes it, focus is handled by the browser.
   Without JavaScript the link jumps here and the list shows inline (see .js in styles). #}
{% set ap = site.approach %}
{% set count = ap.principles | length %}
{% set ov = ap.overlay %}
<dialog id="principles" class="overlay" aria-labelledby="principles-title">
  <div class="overlay__inner">
    <header class="overlay__head">
      <div>
        {% if ov.small_heading %}<p class="eyebrow overlay__eyebrow">{{ ov.small_heading }}</p>{% endif %}
        <h2 id="principles-title" class="overlay__title">{{ ov.title | replace("{count}", count | string) | mdInline | safe }}</h2>
      </div>
      <form method="dialog" class="overlay__close-form">
        <button class="overlay__close" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </form>
    </header>
    <div class="overlay__body">
      {% if ov.introduction %}<p class="overlay__intro">{{ ov.introduction | replace("{count}", count | string) | mdInline | safe }}</p>{% endif %}
      <ol class="overlay__list">
        {%- for p in ap.principles %}
        <li class="overlay__item{% if p.placeholder %} overlay__item--placeholder{% endif %}" style="--i: {{ loop.index0 }}">
          <span class="principle__badge{% if p.highlight_number %} principle__badge--accent{% endif %}">{{ loop.index }}</span>
          <div>
            <h3>{{ p.title }}</h3>
            <p>{{ p.text | mdInline | safe }}</p>
          </div>
        </li>
        {%- endfor %}
      </ol>
    </div>
  </div>
</dialog>
