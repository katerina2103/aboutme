{% set video = site.video_and_meet.video_card %}
<section class="intro-video" aria-labelledby="intro-video-title" data-reveal>
  <div class="intro-video__visual" aria-hidden="true">
    <span class="intro-video__monogram">K.</span>
  </div>
  <div class="intro-video__content">
    <p class="eyebrow">Beyond the CV</p>
    <h2 id="intro-video-title" class="intro-video__title">{{ video.title }}</h2>
    <p class="intro-video__caption">{{ video.caption }}</p>
    {% if video.video_link %}
    <a class="intro-video__link" href="{{ video.video_link }}" target="_blank" rel="noopener noreferrer">Watch my introduction ↗</a>
    {% else %}
    <p class="intro-video__status">{{ video.status }}</p>
    {% endif %}
  </div>
</section>
