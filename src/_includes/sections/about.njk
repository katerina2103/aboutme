{% set about = site.about %}
<section id="about" class="band band--light">
  <div class="band__inner">
    <div>
      <h2 class="section-title about__title" data-reveal style="--i: 0">{{ about.title | mdInline | safe }}</h2>
      {% if about.quote %}<p class="about__quote" data-reveal style="--i: 1">“{{ about.quote }}”</p>{% endif %}
    </div>
    <div class="about__body" data-reveal style="--i: 2">{{ about.body | md | safe }}</div>
  </div>
</section>
