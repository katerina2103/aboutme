<aside class="dilemma decision-lab" aria-label="{{ site.decision_lab.carousel_label }}" aria-roledescription="carousel">
<span class="dilemma__note sticky" style="--tilt:4deg">{{ site.decision_lab.sticker }}</span><div class="lab-slides" tabindex="0" role="region" aria-label="{{ site.decision_lab.slide_region_label }}">
<article class="lab-slide" aria-label="1 of 7">{% include "slides/your-decision.njk" %}</article>
<article class="lab-slide" aria-label="2 of 7">{% include "slides/evidence-and-assumptions.njk" %}</article>
<article class="lab-slide" aria-label="3 of 7">{% include "slides/discovery-and-experiment.njk" %}</article>
<article class="lab-slide" aria-label="4 of 7">{% include "slides/market-comparison.njk" %}</article>
<article class="lab-slide" aria-label="5 of 7">{% include "slides/value-and-reuse.njk" %}</article>
<article class="lab-slide" aria-label="6 of 7">{% include "slides/funding-recommendation.njk" %}</article>
<article class="lab-slide" aria-label="7 of 7">{% include "slides/custom-product-plan.njk" %}</article>
</div><nav class="lab-controls" aria-label="{{ site.decision_lab.controls_label }}" hidden><button type="button" class="lab-prev" aria-label="{{ site.decision_lab.previous_label }}">←</button><span class="lab-count" aria-live="polite" aria-atomic="true"></span><button type="button" class="lab-next">{{ site.decision_lab.next_label }}</button></nav></aside>