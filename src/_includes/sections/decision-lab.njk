<aside class="dilemma decision-lab" aria-label="{{ site.decision_lab.carousel_label }}" aria-roledescription="carousel">
<span class="dilemma__note sticky" style="--tilt:4deg">{{ site.decision_lab.sticker }}</span><div class="lab-slides" tabindex="0" role="region" aria-label="{{ site.decision_lab.slide_region_label }}">
<article data-lab-stage="opening" class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '1') | replace('{total}', '8') }}">{% include "slides/your-decision.njk" %}</article>
<article data-lab-stage="evidence" class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '2') | replace('{total}', '8') }}">{% include "slides/scope-the-problem.njk" %}</article>
<article class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '3') | replace('{total}', '8') }}">{% include "slides/market-comparison.njk" %}</article>
<article class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '4') | replace('{total}', '8') }}">{% include "slides/strategic-tradeoffs.njk" %}</article>
<article class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '5') | replace('{total}', '8') }}">{% include "slides/value-and-reuse.njk" %}</article>
<article data-lab-stage="funding" class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '6') | replace('{total}', '8') }}">{% include "slides/funding-recommendation.njk" %}</article>
<article class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '7') | replace('{total}', '8') }}">{% include "slides/custom-product-plan.njk" %}</article>
<article class="lab-slide lab-celebration" aria-label="{{ site.decision_lab.position_label | replace('{current}', '8') | replace('{total}', '8') }}">{% include "slides/celebration.njk" %}</article>
</div><nav class="lab-controls" aria-label="{{ site.decision_lab.controls_label }}" hidden><div class="lab-progress-status"><div class="lab-progress" role="group" aria-label="Jump to a Decision Lab step"></div><span class="lab-count"></span></div><div class="lab-direction"><button type="button" class="lab-prev" aria-label="{{ site.decision_lab.previous_label }}">{{ site.decision_lab.previous_symbol }}</button><button type="button" class="lab-next" aria-label="{{ site.decision_lab.next_accessible_label }}">{{ site.decision_lab.next_label }}</button></div></nav></aside>