<aside class="dilemma decision-lab" aria-label="{{ site.decision_lab.carousel_label }}" aria-roledescription="carousel">
<span class="dilemma__note sticky" style="--tilt:4deg">{{ site.decision_lab.sticker }}</span><div class="lab-slides" tabindex="0" role="region" aria-label="{{ site.decision_lab.slide_region_label }}">
<article class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '1') | replace('{total}', '9') }}">{% include "slides/your-decision.njk" %}</article>
<article class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '2') | replace('{total}', '9') }}">{% include "slides/evidence-and-assumptions.njk" %}</article>
<article class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '3') | replace('{total}', '9') }}">{% include "slides/discovery-and-experiment.njk" %}</article>
<article class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '4') | replace('{total}', '9') }}">{% include "slides/market-comparison.njk" %}</article>
<article class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '5') | replace('{total}', '9') }}">{% include "slides/strategic-tradeoffs.njk" %}</article>
<article class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '6') | replace('{total}', '9') }}">{% include "slides/value-and-reuse.njk" %}</article>
<article class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '6') | replace('{total}', '9') }}">{% include "slides/funding-recommendation.njk" %}</article>
<article class="lab-slide" aria-label="{{ site.decision_lab.position_label | replace('{current}', '7') | replace('{total}', '9') }}">{% include "slides/custom-product-plan.njk" %}</article>
<article class="lab-slide lab-celebration" aria-label="{{ site.decision_lab.position_label | replace('{current}', '8') | replace('{total}', '9') }}">{% include "slides/celebration.njk" %}</article>
</div><nav class="lab-controls" aria-label="{{ site.decision_lab.controls_label }}" hidden><div class="lab-progress-status"><div class="lab-progress" role="progressbar" aria-label="{{ site.decision_lab.progress_label }}" aria-valuemin="1" aria-valuemax="9" aria-valuenow="1"></div><span class="lab-count" aria-live="polite" aria-atomic="true"></span></div><button type="button" class="lab-prev" aria-label="{{ site.decision_lab.previous_label }}">{{ site.decision_lab.previous_symbol }}</button><button type="button" class="lab-next" aria-label="{{ site.decision_lab.next_accessible_label }}">{{ site.decision_lab.next_label }}</button></nav></aside>