{% set exp = site.experience %}
<section id="work" class="panel">
  <div class="panel__head" data-reveal>
    <h2 class="section-title">{{ exp.title | mdInline | safe }}</h2>
    <p class="panel__aside">{{ exp.introduction | mdInline | safe }}</p>
  </div>
  <div class="impact-grid">
    {%- for case in exp.case_studies %}
    <a class="impact-card" href="#case-{{ case.detail }}" data-open-dialog="case-{{ case.detail }}" aria-haspopup="dialog" aria-controls="case-{{ case.detail }}" data-reveal style="--i: {{ loop.index0 }}">
      <span class="impact-card__sticker sticky" style="--tilt: {{ case.sticky_note_rotation }}deg">{{ case.sticky_note }}</span>
      <span class="impact-card__metric">{{ case.metric }}</span>
      <span class="impact-card__metric-label">{{ case.metric_label }}</span>
      <h3 class="impact-card__title">{{ case.title }}</h3>
      <span class="impact-card__summary">{{ case.summary }}</span>
      <span class="impact-card__action">{{ case.action_label }} →</span>
    </a>
    {%- endfor %}
  </div>
</section>

{% for card in exp.case_studies %}
{% set detail = site.case_studies[card.detail] %}
<dialog id="case-{{ card.detail }}" class="overlay case-overlay" aria-labelledby="case-title-{{ card.detail }}" data-return-hash="#work">
  <div class="overlay__inner">
    <header class="overlay__head">
      <div>
        <p class="eyebrow overlay__eyebrow">{{ "0" if loop.index < 10 }}{{ loop.index }} · {{ detail.context }}</p>
        <h2 id="case-title-{{ card.detail }}" class="overlay__title">{{ detail.title }}</h2>
      </div>
      <form method="dialog" class="overlay__close-form">
        <button class="overlay__close" aria-label="Close case study" autofocus>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </form>
    </header>
    <div class="overlay__body case-detail">
      {% for label in ["problem", "solution", "impact"] %}
      <section class="case-detail__section{% if label == 'impact' %} case-detail__section--impact{% endif %}">
        <h3>{{ label | capitalize }}</h3>
        <div>{{ detail[label] | md | safe }}</div>
      </section>
      {% endfor %}
      <div class="case-principles-link">
        <a class="text-link" href="#principles-{{ card.detail }}" data-open-dialog="principles-{{ card.detail }}" aria-haspopup="dialog" aria-controls="principles-{{ card.detail }}">{{ exp.principles_link }}</a>
      </div>
    </div>
  </div>
</dialog>
{% endfor %}


{% for card in exp.case_studies %}
<dialog id="principles-{{ card.detail }}" class="overlay" aria-labelledby="principles-title-{{ card.detail }}" data-return-hash="#case-{{ card.detail }}">
  <div class="overlay__inner">
    <header class="overlay__head">
      <div><p class="eyebrow">{{ exp.principles_eyebrow }}</p><h2 id="principles-title-{{ card.detail }}" class="overlay__title">{{ exp.principles_title }}</h2></div>
      <form method="dialog" class="overlay__close-form"><button class="overlay__close" aria-label="Close principles and return to story" autofocus><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></form>
    </header>
    <div class="overlay__body">
      <p class="overlay__intro">{{ card.title }}</p>
      {% for principleId in site.case_studies[card.detail].principles %}
      {% set principle = site.principles[principleId] %}
      <section class="case-linked-principle"><h3>{{ principle.title }}</h3><p>{{ principle.text }}</p></section>
      {% endfor %}
    </div>
  </div>
</dialog>
{% endfor %}
