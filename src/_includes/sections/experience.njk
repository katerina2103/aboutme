{% set exp = site.experience %}
<section id="work" class="panel">
  <div class="panel__head" data-reveal>
    <h2 class="section-title">{{ exp.title | mdInline | safe }}</h2>
    <p class="panel__aside">{{ exp.introduction | mdInline | safe }}</p>
  </div>
  <div class="impact-grid">
    {%- for case in exp.case_studies %}
    <a class="impact-card" href="#case-{{ case.detail }}" data-open-dialog="case-{{ case.detail }}" aria-haspopup="dialog" aria-controls="case-{{ case.detail }}" data-reveal style="--i: {{ loop.index0 }}">
      <span class="impact-card__sticker sticky" style="--tilt: {{ case.sticky_note_rotation }}deg">{{ case.sticky_note }}</span>
      <span class="impact-card__metric">{{ case.metric }}</span>
      <span class="impact-card__metric-label">{{ case.metric_label }}</span>
      <h3 class="impact-card__title">{{ case.title }}</h3>
      <span class="impact-card__summary">{{ case.summary }}</span>
      <span class="impact-card__action">{{ case.action_label }} →</span>
    </a>
    {%- endfor %}
  </div>
</section>

{% for card in exp.case_studies %}
{% set detail = site.case_studies[card.detail] %}
<dialog id="case-{{ card.detail }}" class="overlay case-overlay" aria-labelledby="case-title-{{ card.detail }}" data-return-hash="#work">
  <div class="overlay__inner">
    <header class="overlay__head">
      <div>
        <p class="eyebrow overlay__eyebrow">{{ "0" if loop.index < 10 }}{{ loop.index }} · {{ detail.context }}</p>
        <h2 id="case-title-{{ card.detail }}" class="overlay__title">{{ detail.title }}</h2>
      </div>
      <form method="dialog" class="overlay__close-form">
        <button class="overlay__close" aria-label="{{ exp.dialog_labels.close }}" autofocus>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </form>
    </header>
    <div class="case-tabs" role="tablist" aria-label="{{ exp.dialog_labels.views }}">
      <button type="button" class="case-tab" id="story-tab-{{ card.detail }}" role="tab" aria-controls="story-{{ card.detail }}" aria-selected="true" data-case-tab="story">{{ exp.dialog_labels.story_tab }}</button>
      <button type="button" class="case-tab" id="principles-tab-{{ card.detail }}" role="tab" aria-controls="principles-{{ card.detail }}" aria-selected="false" tabindex="-1" data-case-tab="principles">{{ exp.dialog_labels.principles_tab }}</button>
    </div>
    <div class="overlay__body case-detail case-tab-panel" id="story-{{ card.detail }}" role="tabpanel" aria-labelledby="story-tab-{{ card.detail }}">
      {% for label in ["problem", "solution", "impact"] %}
      <section class="case-detail__section{% if label == 'impact' %} case-detail__section--impact{% endif %}">
        <h3 class="case-detail__heading"><span class="case-detail__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">{% if label == 'problem' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/>{% elif label == 'solution' %}<path d="M9 18h6m-5 3h4M8.5 14.5a6 6 0 1 1 7 0c-1 .8-1.5 1.5-1.5 3.5h-4c0-2-.5-2.7-1.5-3.5Z"/>{% else %}<path d="M4 4v16h16M8 15l4-4 3 2 5-7m-5 0h5v5"/>{% endif %}</svg></span>{{ exp.dialog_labels.sections[label] }}</h3>
        <div>{{ detail[label] | md | safe }}</div>
      </section>
      {% endfor %}
    </div>
    <div class="overlay__body case-principles case-tab-panel" id="principles-{{ card.detail }}" role="tabpanel" aria-labelledby="principles-tab-{{ card.detail }}" hidden>
      {% for principleId in detail.principles %}
      {% set principle = site.principles[principleId] %}
      <section class="case-detail__section case-principle-row">
        <div class="case-detail__heading"><span class="case-detail__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          {% if principleId == 'make-room-for-tomorrow' %}<path d="M3 18h18M5 14l5-5 4 3 5-7m-5 0h5v5"/>
          {% elif principleId == 'build-in-learning-steps' %}<path d="M3 19h6v-5h6V9h6M17 5h4v4"/>
          {% elif principleId == 'make-value-concrete' %}<path d="M4 19h16M7 15v-4m5 4V7m5 8V4"/>
          {% elif principleId == 'understand-before-change' %}<path d="M15.5 15.5 21 21M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/>
          {% elif principleId == 'bring-people-into-change' %}<path d="M4 20v-2a4 4 0 0 1 4-4h3a4 4 0 0 1 4 4v2m2-6a4 4 0 0 1 3 4v2M13 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm4-3a3 3 0 0 1 0 6"/>
          {% elif principleId == 'question-behind-the-question' %}<path d="M9 9a3 3 0 1 1 4 2.8c-1 .5-1 1.2-1 2.2m0 3h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
          {% elif principleId == 'show-participation-matters' %}<path d="M4 5h16v11H9l-5 4V5Zm4 6 2 2 5-5"/>
          {% elif principleId == 'adapt-and-persist' %}<path d="M20 10a8 8 0 0 0-14-4L3 9m0-5v5h5m-4 5a8 8 0 0 0 14 4l3-3m0 5v-5h-5"/>
          {% else %}<circle cx="12" cy="12" r="8"/><path d="m15 9-2 4-4 2 2-4Z"/>
          {% endif %}
        </svg></span></div>
        <div><h3 class="case-principle-title">{{ principle.title }}</h3><p>{{ principle.text }}</p></div>
      </section>
      {% endfor %}
    </div>
  </div>
</dialog>
{% endfor %}
