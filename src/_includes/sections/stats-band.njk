{% if site.stats_band.stats | length %}
<section class="stats" data-reveal>
  {%- for stat in site.stats_band.stats %}
  <div data-reveal style="--i: {{ loop.index0 + 1 }}">
    <div class="stats__number">{{ stat.number }}</div>
    <p class="stats__label">{{ stat.label }}</p>
  </div>
  {%- endfor %}
</section>
{% endif %}
