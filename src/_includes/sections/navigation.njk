{% set nav = site.navigation %}
<nav class="nav container">
  <a class="nav__brand" href="#">{{ nav.name_first }} <em>{{ nav.name_last }}</em></a>
  <div class="nav__links">
    {%- for item in nav.links %}
    <a href="{{ item.link }}"{% if item.show_as_button %} class="nav__button"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
    <button class="theme-toggle" type="button" aria-pressed="false" data-dark-label="{{ nav.theme_toggle.dark_label }}" data-light-label="{{ nav.theme_toggle.light_label }}" hidden>
      <svg class="theme-toggle__moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg>
      <svg class="theme-toggle__sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
      <span>{{ nav.theme_toggle.dark_label }}</span>
    </button>
  </div>
</nav>
