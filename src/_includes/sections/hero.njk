{% set hero = site.hero %}
{% set card = hero.dilemma_card %}
{# data-reveal: fades in on load/scroll. --i: stagger order (each step ≈ 90ms later). #}
<section class="hero">
  <div>
    <p class="eyebrow" data-reveal style="--i: 0">{{ hero.small_heading }}</p>
    <h1 class="hero__title" data-reveal style="--i: 1">{{ hero.headline | mdInline | safe }}</h1>
    <div class="hero__intro" data-reveal style="--i: 2">{{ hero.body | md | safe }}</div>
    <div class="hero__buttons" data-reveal style="--i: 3">
      <a class="btn btn--outline social-btn" href="{{ hero.secondary_button.link }}" target="_blank" rel="noopener noreferrer"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8v-4.65c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.79-1.52 2.98 0 3.58 1.96 3.58 4.51v5.26Z"/></svg><span>LinkedIn</span><span class="social-btn__arrow" aria-hidden="true">↗</span></a>
      <a class="btn btn--outline social-btn" href="https://medium.com/@katerina2103/activity" target="_blank" rel="noopener noreferrer"><svg width="22" height="18" viewBox="0 0 28 20" fill="currentColor" aria-hidden="true" focusable="false"><ellipse cx="8" cy="10" rx="8" ry="8"/><ellipse cx="20" cy="10" rx="4" ry="7.5"/><ellipse cx="26.5" cy="10" rx="1.5" ry="7"/></svg><span>Medium</span><span class="social-btn__arrow" aria-hidden="true">↗</span></a>
      <a class="btn btn--outline social-btn" href="https://substack.com/@katyashimanovskaya/notes" target="_blank" rel="noopener noreferrer"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M3 2h18v2H3zm0 5h18v2H3zm0 5h18v12l-9-5-9 5z"/></svg><span>Substack</span><span class="social-btn__arrow" aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="hero__portrait" data-reveal style="--i: 4">
    {% if hero.portrait_image %}
    <img src="{{ hero.portrait_image }}" alt="Portrait of Katya Shimanovskaya" width="520" height="640" loading="eager">
    {% else %}
    <div class="hero__portrait-fallback"><span class="hero__portrait-initial">K.</span><span class="hero__portrait-caption">Curiosity meets purpose.</span></div>
    {% endif %}
  </div>
</section>

