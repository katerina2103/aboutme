{% set hero = site.hero %}
{% set card = hero.dilemma_card %}
{# data-reveal: fades in on load/scroll. --i: stagger order (each step ≈ 90ms later). #}
<section class="hero">
  <div>
    <p class="eyebrow" data-reveal style="--i: 0">{{ hero.small_heading }}</p>
    <h1 class="hero__title" data-reveal style="--i: 1">{{ hero.headline | mdInline | safe }}</h1>
    <div class="hero__intro" data-reveal style="--i: 2">{{ hero.body | md | safe }}</div>
    <div class="hero__buttons" data-reveal style="--i: 3">
      <a class="btn btn--solid" href="{{ hero.primary_button.link }}">{{ hero.primary_button.label }}</a>
      <a class="btn btn--outline" href="{{ hero.secondary_button.link }}"{% if hero.secondary_button.icon == "linkedin" %} target="_blank" rel="noopener noreferrer"{% endif %}>{% if hero.secondary_button.icon == "linkedin" %}<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" style="vertical-align: -3px; margin-right: 8px"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8v-4.65c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.79-1.52 2.98 0 3.58 1.96 3.58 4.51v5.26Z"/></svg>{% endif %}{{ hero.secondary_button.label }}</a>
    </div>
  </div>
  {% if card %}
  <aside class="dilemma" data-reveal="right" style="--i: 3">
    {% if card.sticky_note %}<span class="dilemma__note sticky" style="--tilt: 4deg">{{ card.sticky_note }}</span>{% endif %}
    <p class="dilemma__eyebrow">{{ card.small_heading }}</p>
    <h2 class="dilemma__title">{{ card.title | mdInline | safe }}</h2>
    <p class="dilemma__question">{{ card.question | mdInline | safe }}</p>
    <div class="dilemma__options">
      {%- for option in card.options %}
      <div class="dilemma__option" data-reveal style="--i: {{ loop.index0 + 5 }}">
        <h3>{{ option.title }}</h3>
        <p>{{ option.text | mdInline | safe }}</p>
      </div>
      {%- endfor %}
    </div>
    {% if card.footnote %}<p class="dilemma__footnote">{{ card.footnote }}</p>{% endif %}
  </aside>
  {% endif %}
</section>

