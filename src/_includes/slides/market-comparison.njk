
<p class="lab-step">{{ site.lab_slides.market_comparison.copy.market_scan }}</p><h2 class="dilemma__title">{{ site.lab_slides.market_comparison.copy.buy_adapt_or_build }}</h2>
<p class="business-intro">{{ site.lab_slides.market_comparison.copy.compare_equivalent_scope_source_coverage_permissions_useful }}</p>
<fieldset class="compare-picker"><legend>{{ site.lab_slides.market_comparison.copy.choose_options_to_compare }}</legend><label><input type="checkbox" data-compare="copilot">{{ site.lab_slides.market_comparison.copy.microsoft_365_copilot }}</label><label><input type="checkbox" data-compare="glean" checked>{{ site.lab_slides.market_comparison.copy.glean }}</label><label><input type="checkbox" data-compare="benchling">{{ site.lab_slides.market_comparison.copy.benchling_ai }}</label><label><input type="checkbox" data-compare="haystack">{{ site.lab_slides.market_comparison.copy.haystack_hosted_model }}</label><label><input type="checkbox" data-compare="custom" checked>{{ site.lab_slides.market_comparison.copy.custom_application }}</label></fieldset><p class="lab-matrix-legend">{{ site.lab_slides.market_comparison.copy.range_legend }}</p><p class="compare-status" role="status" aria-live="polite">{{ site.lab_slides.market_comparison.copy.comparing_2_options }}</p><div class="business-table-scroll" tabindex="0" role="region" aria-label="{{ site.lab_slides.market_comparison.copy.selected_business_case_options }}"><table class="business-table business-table--transpose lab-comparison-matrix"><caption>{{ site.lab_slides.market_comparison.copy.compare_routes_to_a_scientific_evidence_assistant }}</caption><thead><tr><th scope="col">{{ site.lab_slides.market_comparison.copy.decision_criteria }}</th><th scope="col" data-option="copilot" hidden><a href="{{ site.lab_slides.market_comparison.copy.source_link_1 }}" target="_blank" rel="noopener noreferrer">{{ site.lab_slides.market_comparison.copy.microsoft_365_copilot_2 }}</a><span>{{ site.lab_slides.market_comparison.copy.buy_existing_m365_estate }}</span></th><th scope="col" data-option="glean"><a href="{{ site.lab_slides.market_comparison.copy.source_link_2 }}" target="_blank" rel="noopener noreferrer">{{ site.lab_slides.market_comparison.copy.glean_2 }}</a><span>{{ site.lab_slides.market_comparison.copy.buy_cross_system_retrieval }}</span></th><th scope="col" data-option="benchling" hidden><a href="{{ site.lab_slides.market_comparison.copy.source_link_3 }}" target="_blank" rel="noopener noreferrer">{{ site.lab_slides.market_comparison.copy.benchling_ai_2 }}</a><span>{{ site.lab_slides.market_comparison.copy.buy_records_already_in_benchling }}</span></th><th scope="col" data-option="haystack" hidden><a href="{{ site.lab_slides.market_comparison.copy.source_link_4 }}" target="_blank" rel="noopener noreferrer">{{ site.lab_slides.market_comparison.copy.haystack_hosted_model_2 }}</a><span>{{ site.lab_slides.market_comparison.copy.adapt_open_source_hybrid }}</span></th><th scope="col" data-option="custom">{{ site.lab_slides.market_comparison.copy.custom_application_2 }}<span>{{ site.lab_slides.market_comparison.copy.build_differentiated_scientific_workflow }}</span></th></tr></thead><tbody><tr><th scope="row">{{ site.lab_slides.market_comparison.copy.cost_and_team }}<span>{{ site.lab_slides.market_comparison.copy.cost_scale_label }}</span></th>{% for cost in site.lab_slides.market_comparison.copy.visual_costs %}<td data-option="{{ cost.option }}"{% if cost.option != 'glean' and cost.option != 'custom' %} hidden{% endif %}><strong class="lab-cost-value">{{ cost.amount }}</strong><div class="lab-cost-range" role="img" aria-label="{{ site.lab_slides.market_comparison.copy.range_accessible_label }}: {{ cost.amount }}. {% if loop.index <= 3 %}{{ site.lab_slides.market_comparison.copy.range_not_total }}{% endif %}"><i style="--range-start:{{ cost.start_percent }}%;--range-width:{{ cost.range_percent }}%"></i></div><span>{{ cost.team }}</span>{% if cost.option == 'copilot' %}<span>{{ site.lab_slides.market_comparison.copy.us_216k_year_licenses_for_600_seats }}</span>{% elif cost.option == 'glean' %}<span>{{ site.lab_slides.market_comparison.copy.vendor_quote_no_verified_public_list_price }}</span>{% elif cost.option == 'benchling' %}<span>{{ site.lab_slides.market_comparison.copy.platform_ai_usage_quote_and_any_migration }}</span>{% elif cost.option == 'haystack' %}<span>{{ site.lab_slides.market_comparison.copy.staff_480k_1_01m_infrastructure_api_40 }}</span>{% elif cost.option == 'custom' %}<span>{{ site.lab_slides.market_comparison.copy.staff_840k_1_68m_infrastructure_api_80 }}</span>{% endif %}</td>{% endfor %}</tr><tr><th scope="row">{{ site.lab_slides.market_comparison.copy.value }}{{ site.lab_slides.market_comparison.copy.label }}{{ site.lab_slides.market_comparison.copy.trade_off }}</th><td data-option="copilot" hidden>{{ site.lab_slides.market_comparison.copy.existing_office_ecosystem }}<span>{{ site.lab_slides.market_comparison.copy.lab_source_integration_and_permissions_need_proof }}</span></td><td data-option="glean">{{ site.lab_slides.market_comparison.copy.broad_permissions_aware_retrieval }}<span>{{ site.lab_slides.market_comparison.copy.scientific_parsing_and_source_freshness_need_proof }}</span></td><td data-option="benchling" hidden>{{ site.lab_slides.market_comparison.copy.lab_native_workflows }}<span>{{ site.lab_slides.market_comparison.copy.external_source_coverage_and_migration_may_dominate }}</span></td><td data-option="haystack" hidden>{{ site.lab_slides.market_comparison.copy.more_control_over_retrieval_and_evaluation }}<span>{{ site.lab_slides.market_comparison.copy.we_own_connectors_access_enforcement_and_operations }}</span></td><td data-option="custom">{{ site.lab_slides.market_comparison.copy.most_workflow_control }}<span>{{ site.lab_slides.market_comparison.copy.highest_engineering_burden_slowest_fit_to_current }}</span></td></tr>{% for criterion in site.lab_slides.market_comparison.copy.additional_criteria %}
<tr><th scope="row">{{ criterion.label }}</th>{% for cell in criterion.cells %}<td data-option="{{ cell.option }}"{% if cell.option != 'glean' and cell.option != 'custom' %} hidden{% endif %}>
{% if cell.source_url %}<a href="{{ cell.source_url }}" target="_blank" rel="noopener noreferrer">{{ cell.summary }}</a>{% else %}{{ cell.summary }}{% endif %}<span>{{ cell.detail }}{% if cell.detail_source_url %} <a href="{{ cell.detail_source_url }}" target="_blank" rel="noopener noreferrer">{{ site.lab_slides.market_comparison.copy.detail_source_label }}</a>{% endif %}</span></td>{% endfor %}</tr>
{% endfor %}<tr><th scope="row">{{ site.lab_slides.market_comparison.copy.decision_gate }}</th><td data-option="copilot" hidden>{{ site.lab_slides.market_comparison.copy.demonstrate_eln_lims_coverage_and_access_controls }}</td><td data-option="glean">{{ site.lab_slides.market_comparison.copy.connect_our_lab_systems_and_verify_answers }}</td><td data-option="benchling" hidden>{{ site.lab_slides.market_comparison.copy.prove_useful_coverage_within_and_beyond_benchling }}</td><td data-option="haystack" hidden>{{ site.lab_slides.market_comparison.copy.show_a_vendor_gap_worth_owning_and }}</td><td data-option="custom">{{ site.lab_slides.market_comparison.copy.prove_a_repeatable_need_beyond_vendor_capabilities }}</td></tr></tbody></table></div><p class="business-scroll-hint">{{ site.lab_slides.market_comparison.copy.select_more_options_above_scroll_across_when }}</p><div class="business-verdict"><strong>{{ site.lab_slides.market_comparison.copy.my_business_case_starting_point }}</strong><p>{{ site.lab_slides.market_comparison.copy.test_an_existing_estate_vendor_against_improved }}</p></div>
<details class="lab-more"><summary>{{ site.lab_slides.market_comparison.copy.verification_heading }}</summary>{% for check in site.lab_slides.market_comparison.copy.verification_checks %}<p><strong>{{ check.label }}:</strong> {{ check.text }}</p>{% endfor %}</details>
<script type="application/json" id="comparison-context">{{ site.lab_slides.market_comparison.copy | jsonForScript | safe }}</script>
