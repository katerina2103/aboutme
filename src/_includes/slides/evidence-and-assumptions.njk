{% set slide = site.lab_slides.evidence_and_assumptions %}
<p class="lab-step">{{ slide.copy.evidence }}{{ slide.copy.label }}{{ slide.copy.assumptions }}</p><h2 class="dilemma__title">{{ slide.copy.size_the_problem }} {{ slide.copy.test_the_assumptions }}</h2>
<p class="lab-handoff"><span class="lab-handoff-choice"></span><span class="lab-handoff-route">{{ site.decision_lab.handoff.route }}</span></p>
<div class="evidence-compact">
  <section class="insight insight--assumption">
    <span class="insight-label">{{ slide.hypothesis.label }}</span>
    <h3><strong>{{ slide.hypothesis.value }}</strong>{{ slide.hypothesis.description }}</h3>
    <p>{{ slide.hypothesis.next_step }}</p>
  </section>
  <div class="evidence-signals" aria-label="{{ slide.signals_label }}">
    {% for signal in slide.signals %}
    <section class="insight">
      <span class="insight-label">{{ signal.label }}</span>
      <h3><strong>{{ signal.value }}</strong>{{ signal.description }}</h3>
    </section>
    {% endfor %}
  </div>
  <details class="evidence-details">
    <summary>{{ slide.details.label }}</summary>
    <p>{{ slide.details.introduction }}</p>
    {% for source in slide.details.sources %}
    <p><a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.label }}</a>{{ source.limits }}</p>
    {% endfor %}
    <p>{{ slide.details.validation }}</p>
  </details>
</div>
