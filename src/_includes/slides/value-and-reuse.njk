{% set slide = site.lab_slides.value_and_reuse.sequence %}
<p class="lab-step">{{ slide.step | escape }}</p>
<h2 class="dilemma__title">{{ slide.title | escape }}</h2>
<p class="business-intro">{{ slide.intro | escape }}</p>
<div class="pilot-board">
<section class="lab-recommendation pilot-call">
<h3>{{ slide.ceo_ask | escape }}</h3>
<p><strong>{{ slide.investment_label | escape }}</strong> {{ slide.investment_basis | escape }}</p>
<p><strong>{{ slide.capacity_label | escape }}</strong> {{ slide.capacity_impact | escape }}</p>
<p><strong>{{ slide.tradeoff_label | escape }}</strong> {{ slide.tradeoff | escape }}</p>
</section>
<section class="pilot-block pilot-team">
<h3>{{ slide.who_i_d_ask_to_run | escape }}</h3>
<p>{{ slide.team_intro | escape }} <strong>{{ slide.team_roles | escape }}</strong>{{ slide.i_d_ask_their_managers_to | escape }}</p>
<ol><li><strong>{{ slide.setup_weeks | escape }}</strong> {{ slide.setup_work | escape }}</li><li><strong>{{ slide.test_weeks | escape }}</strong> {{ slide.test_work | escape }}</li><li><strong>{{ slide.review_weeks | escape }}</strong> {{ slide.review_work | escape }}</li></ol>
</section>
<section class="pilot-block">
<h3>{{ slide.what_glean_needs_to_prove | escape }}</h3>
<dl class="pilot-checks">
<div><dt>{{ slide.speed_label | escape }}</dt><dd><strong>{{ slide.25_less_time | escape }}</strong> {{ slide.on_30_matched_tasks_including_citation | escape }} <a href="https://assets-c4akfrf5b4d3f4b7.z01.azurefd.net/assets/2023/11/Microsoft_Work_Trend_Index_Special_Report_2023_Full_Report.pdf">{{ slide.speed_source | escape }}</a></dd></div>
<div><dt>{{ slide.accuracy_label | escape }}</dt><dd><strong>{{ slide.at_least_27_of_30 | escape }}</strong>{{ slide.with_no_drop_versus_current_search | escape }}</dd></div>
<div><dt>{{ slide.permissions_label | escape }}</dt><dd><strong>{{ slide.permissions_result | escape }}</strong></dd></div>
<div><dt>{{ slide.coverage_label | escape }}</dt><dd><strong>{{ slide.3_of_3_covered | escape }}</strong></dd></div>
<div><dt>{{ slide.usage_label | escape }}</dt><dd><strong>{{ slide.at_least_60 | escape }}</strong> {{ slide.active_in_both_final_weeks | escape }}</dd></div>
</dl>
</section>
<details class="lab-more"><summary>{{ slide.benchmarks_heading | escape }}</summary>
<p><strong>{{ slide.microsoft_result | escape }}</strong> {{ slide.microsoft_context | escape }} <a href="https://assets-c4akfrf5b4d3f4b7.z01.azurefd.net/assets/2023/11/Microsoft_Work_Trend_Index_Special_Report_2023_Full_Report.pdf">{{ slide.microsoft_source | escape }}</a>{{ slide.microsoft_application | escape }}</p>
<p><strong>{{ slide.setup_estimate | escape }}</strong> {{ slide.setup_context | escape }} <a href="https://docs.glean.com/get-started/welcome">{{ slide.setup_source | escape }}</a>{{ slide.connector_context | escape }} <strong>{{ slide.connector_status | escape }}</strong> <a href="https://www.glean.com/connectors/benchling">{{ slide.connector_source | escape }}</a>{{ slide.connector_end | escape }}</p>
</details></div>
