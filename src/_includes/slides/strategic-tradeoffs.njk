{% set strategy = site.lab_slides.strategic_tradeoffs %}
<p class="lab-step">{{ strategy.label }}</p>
<h2 class="dilemma__title">{{ strategy.title }}</h2>
<p class="business-intro">{{ strategy.intro | escape }}</p>
<section class="strategy-lab" aria-label="{{ strategy.comparison_label | escape }}"><div class="model-panel">
<strong id="priority-heading">{{ strategy.priority_heading | escape }}</strong>
<div class="ceo-view-buttons strategy-priority-buttons" role="group" aria-labelledby="priority-heading">
<button type="button" data-priority="acquisition" class="is-selected" aria-pressed="true" data-priority-insight="{{ strategy.acquisition_summary | escape }}">{{ strategy.acquisition_label | escape }}</button>
<button type="button" data-priority="scientific" aria-pressed="false" data-priority-insight="{{ strategy.scientific_summary | escape }}">{{ strategy.scientific_label | escape }}</button>
<button type="button" data-priority="cost" aria-pressed="false" data-priority-insight="{{ strategy.cost_summary | escape }}">{{ strategy.cost_label | escape }}</button>
</div>
</div><div class="strategy-summary"><span class="strategy-summary__icon" aria-hidden="true">💡</span><div><strong>{{ strategy.summary_heading | escape }}</strong><p data-strategy-insight role="status"></p></div></div><div class="strategy-scores"><div class="strategy-score" data-strategy-option="glean"><div class="strategy-score__head"><strong>{{ strategy.glean_name | escape }}</strong><span data-strategy-score="glean">3.20 / 5</span></div><span class="route-status">{{ strategy.glean_status | escape }}</span><p>{{ strategy.glean_reason | escape }}</p><div class="strategy-score__track"><div class="strategy-score__bar" data-strategy-bar="glean" style="width:64%"></div></div></div><div class="strategy-score" data-strategy-option="hybrid"><div class="strategy-score__head"><strong>{{ strategy.hybrid_name | escape }}</strong><span data-strategy-score="hybrid">3.15 / 5</span></div><span class="route-status">{{ strategy.hybrid_status | escape }}</span><p>{{ strategy.hybrid_reason | escape }}</p><div class="strategy-score__track"><div class="strategy-score__bar" data-strategy-bar="hybrid" style="width:63%"></div></div></div><div class="strategy-score" data-strategy-option="custom"><div class="strategy-score__head"><strong>{{ strategy.custom_name | escape }}</strong><span data-strategy-score="custom">2.55 / 5</span></div><span class="route-status">{{ strategy.custom_status | escape }}</span><p>{{ strategy.custom_reason | escape }}</p><div class="strategy-score__track"><div class="strategy-score__bar" data-strategy-bar="custom" style="width:51%"></div></div></div></div><div class="lab-recommendation decision-call"><strong>{{ strategy.recommendation_heading | escape }}</strong><p>{{ strategy.recommendation | escape }}</p><p><strong>{{ strategy.challenge_heading | escape }}</strong> {{ strategy.challenge | escape }}</p></div><details class="lab-more"><summary>{{ strategy.calculation_heading | escape }}</summary>
<div class="strategy-table-scroll"><table class="strategy-table"><thead><tr><th>{{ strategy.criterion_heading | escape }}</th><th>{{ strategy.glean_name | escape }}</th><th>{{ strategy.hybrid_name | escape }}</th><th>{{ strategy.build_table_label | escape }}</th></tr></thead><tbody>
<tr><th>{{ strategy.criterion_1 | escape }} <span data-strategy-weight="0">30%</span></th><td>4</td><td>3</td><td>2</td></tr>
<tr><th>{{ strategy.criterion_2 | escape }} <span data-strategy-weight="1">25%</span></th><td>3</td><td>4</td><td>4</td></tr>
<tr><th>{{ strategy.criterion_3 | escape }} <span data-strategy-weight="2">20%</span></th><td>3</td><td>2</td><td>1</td></tr>
<tr><th>{{ strategy.criterion_4 | escape }} <span data-strategy-weight="3">15%</span></th><td>3</td><td>3</td><td>3</td></tr>
<tr><th>{{ strategy.criterion_5 | escape }} <span data-strategy-weight="4">10%</span></th><td>2</td><td>4</td><td>3</td></tr>
</tbody></table></div>
<p>{{ strategy.calculation_note | escape }}</p>
</details>
<p class="scenario-note">{{ strategy.scenario_note | escape }}</p>
</section>
