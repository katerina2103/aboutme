{% set slide = site.lab_slides.funding_recommendation.sequence %}
<p class="lab-step">{{ slide.step | escape }}</p>
<h2 class="dilemma__title">{{ slide.title | escape }}</h2>
<p class="business-intro">{{ slide.intro | escape }}</p>
<div class="pilot-board">
<section class="pilot-block pilot-evidence">
<h3>{{ slide.simulated_results | escape }}</h3>
<div class="pilot-metrics">
<article class="pilot-metric pilot-speed">
<h4 class="pilot-metric-label"><span class="pilot-check" role="img" aria-label="Target met" title="Target met">✓</span><span>{{ slide.time_to_a_verified_answer | escape }}</span></h4>
<div class="pilot-times"><div><span>{{ slide.current_search | escape }}</span><strong>{{ slide.20_min | escape }}</strong></div><span aria-hidden="true">→</span><div><span>{{ slide.with_glean | escape }}</span><strong>{{ slide.14_min | escape }}</strong></div></div>
<p><strong>{{ slide.30_less_time | escape }}</strong> {{ slide.across_30_matched_tasks_including_citation | escape }}</p>
<p>{{ slide.target_25_less_time | escape }}<a href="https://assets-c4akfrf5b4d3f4b7.z01.azurefd.net/assets/2023/11/Microsoft_Work_Trend_Index_Special_Report_2023_Full_Report.pdf">{{ slide.microsoft_benchmark | escape }}</a>{{ slide.punctuation | escape }}</p>
</article>
<article class="pilot-metric pilot-miss">
<h4 class="pilot-metric-label"><span class="pilot-check pilot-check--miss" aria-hidden="true"></span><span>{{ slide.critical_lab_workflows | escape }}</span></h4>
<span class="pilot-status">{{ slide.missed_target | escape }}</span>
<strong class="pilot-number">{{ slide.2_of_3_covered | escape }}</strong>
<p>{{ slide.target_3_of_3_glean_left | escape }}</p>
</article>
</div>
<dl class="pilot-checks">
<div><dt class="pilot-metric-label"><span class="pilot-check" role="img" aria-label="Target met" title="Target met">✓</span><span>{{ slide.correct_cited_answers | escape }}</span></dt><dd><strong>{{ slide.28_of_30 | escape }}</strong> {{ slide.with_both_search_methods_target_at | escape }}</dd></div>
<div><dt class="pilot-metric-label"><span class="pilot-check" role="img" aria-label="Target met" title="Target met">✓</span><span>{{ slide.access_to_restricted_records | escape }}</span></dt><dd><strong>{{ slide.0_disclosures_in_20_checks | escape }}</strong> {{ slide.target_0_disclosures_in_20_checks | escape }}</dd></div>
<div><dt class="pilot-metric-label"><span class="pilot-check" role="img" aria-label="Target met" title="Target met">✓</span><span>{{ slide.repeat_usage | escape }}</span></dt><dd><strong>{{ slide.62_5_15_of_24 | escape }}</strong> {{ slide.active_in_both_final_weeks_target | escape }}</dd></div>
</dl>
</section><section class="pilot-block pilot-call lab-recommendation">
<h3>{{ slide.my_call_expand_glean_to_the | escape }}</h3>
<p>{{ slide.six_minutes_less_per_task_is | escape }}</p>
<p><strong>{{ slide.what_could_this_mean_for_600 | escape }}</strong> {{ slide.if_60_use_glean_regularly_and | escape }} <strong>{{ slide.16_560_hours_over_46_weeks | escape }}</strong>{{ slide.before_using_that_figure_to_justify | escape }}</p>
</section></div>
