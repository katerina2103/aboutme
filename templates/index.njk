<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="{{ copy.site.description }}"><title>{{ copy.site.title }}</title><link rel="stylesheet" href="./styles.css"></head><body><nav><a class="logo" href="{{ copy.text["nav"]["link1"] }}">Katya<span>{{ copy.text["nav"]["span1"] | inline | safe }}</span></a><div class="links">{% for item in copy.text.navigation %}<a href="#{{ item.id }}"{% if item.id == "connect" %} class="nav-contact"{% endif %}>{{ item.label }}</a>{% endfor %}</div></nav><main><hero><div><h1>{{ copy.text["hero"]["h1_1"] | inline | safe }}</h1><div class="prose" data-copy-markdown="true">{{ copy.prose["hero-paragraph1"] | markdown | safe }}</div><a class="button" href="{{ copy.text["hero"]["link1"] }}">{{ copy.text["hero"]["a1"] | inline | safe }}</a><a class="button secondary" href="{{ copy.text["hero"]["link2"] }}">{{ copy.text["hero"]["a2"] | inline | safe }}</a><div style="margin-top:18px">{% if copy.site.cv %}<a class="cv-control" href="{{ copy.site.cv }}" download="">Download CV ↓</a>{% else %}<button class="cv-control" disabled aria-describedby="cv-pending">{{ copy.text["hero"]["button1"] | inline | safe }}</button>{% endif %}<span id="cv-pending" style="font-size:12px;color:var(--muted);margin-left:12px">{{ copy.text["hero"]["span1"] | inline | safe }}</span></div></div><aside class="hero-proof" aria-labelledby="proof-title"><p class="proof-context">{{ copy.text.hero.proof_context }}</p><h2 id="proof-title">{{ copy.text.hero.proof_title }}</h2><p class="proof-question">{{ copy.text.hero.proof_question }}</p><div class="proof-decision"><h3>{{ copy.text.hero.proof_choice }}</h3><p>{{ copy.text.hero.proof_detail }}</p></div><div class="proof-decision"><h3>{{ copy.text.hero.proof_scope }}</h3><p>{{ copy.text.hero.proof_scope_detail }}</p></div><p class="proof-note">{{ copy.text.hero.proof_note }}</p><a href="#case-concept" data-case="2" class="proof-link">{{ copy.text.hero.proof_action }}</a></aside>{% if copy.site.portrait %}<img class="portrait" src="{{ copy.site.portrait }}" alt="{{ copy.site.portraitAlt }}">{% endif %}</hero><div class="strap"><span>{{ copy.text["site"]["span1"] | inline | safe }}</span><span>{{ copy.text["site"]["span2"] | inline | safe }}</span><span>{{ copy.text["site"]["span3"] | inline | safe }}</span></div>






<section id="work"><div class="sectiontop"><div><h2>{{ copy.text["work"]["h2_1"] | inline | safe }}</h2></div><div class="prose" data-copy-markdown="true">{{ copy.prose["work-paragraph1"] | markdown | safe }}</div></div><div class="worklist">{% for item in copy.cases %}<a href="{{ item.anchor }}" class="work" data-case="{{ loop.index0 }}"><span class="num">0{{ loop.index }}</span><div><h3>{{ item.title }}</h3><p>{{ item.summary }}</p>{% for tag in item.tags %}<span class="tag">{{ tag }}</span>{% endfor %}</div><span class="arrow">↗</span></a>{% endfor %}</div></section>
<section id="approach" class="twocol"><div><h2>{{ copy.text["approach"]["h2_1"] | inline | safe }}</h2><div class="prose" data-copy-markdown="true">{{ copy.prose["approach-paragraph1"] | markdown | safe }}</div><a href="{{ copy.text["approach"]["link1"] }}" class="button secondary" id="open-principles" style="margin-left:0">{{ copy.text["approach"]["a1"] | inline | safe }}</a></div><div class="principles"><article><h3>{{ copy.text["approach"]["h3_1"] | inline | safe }}</h3><div class="prose" data-copy-markdown="true">{{ copy.prose["approach-paragraph2"] | markdown | safe }}</div></article><article><h3>{{ copy.text["approach"]["h3_2"] | inline | safe }}</h3><div class="prose" data-copy-markdown="true">{{ copy.prose["approach-paragraph3"] | markdown | safe }}</div></article><article><h3>{{ copy.text["approach"]["h3_3"] | inline | safe }}</h3><div class="prose" data-copy-markdown="true">{{ copy.prose["approach-paragraph4"] | markdown | safe }}</div></article><article><h3>{{ copy.text["approach"]["h3_4"] | inline | safe }}</h3><div class="prose" data-copy-markdown="true">{{ copy.prose["approach-paragraph5"] | markdown | safe }}</div></article></div></section>
<section class="about twocol" id="about"><div><h2>{{ copy.text["about"]["h2_1"] | inline | safe }}</h2><div class="quote">{{ copy.text["about"]["div2"] | inline | safe }}</div></div><div><div class="prose" data-copy-markdown="true">{{ copy.prose["about-paragraph1"] | markdown | safe }}</div><div class="prose" data-copy-markdown="true">{{ copy.prose["about-paragraph2"] | markdown | safe }}</div></div></section>
<section id="meet" class="preview-section"><details class="upcoming-preview" {% if copy.site.video %}open{% endif %}><summary><span>{{ copy.text.previews.video }}</span><span class="preview-status">{{ copy.text.previews.status }}</span><span class="preview-toggle" aria-hidden="true">+</span></summary><div class="preview-content twocol"><div><h2>{{ copy.text["meet"]["h2_1"] | inline | safe }}</h2><div class="prose" data-copy-markdown="true">{{ copy.prose["meet-paragraph1"] | markdown | safe }}</div></div><div class="video-stage">{% if not copy.site.video %}<div id="video-placeholder"><span class="play-circle">{{ copy.text["meet"]["span1"] | inline | safe }}</span><h3>{{ copy.text["meet"]["h3_1"] | inline | safe }}</h3><div class="prose" data-copy-markdown="true">{{ copy.prose["meet-paragraph2"] | markdown | safe }}</div></div>{% endif %}{% if copy.site.video %}<video src="{{ copy.site.video }}" id="intro-video" controls playsinline aria-label="Katya’s personal introduction"></video>{% else %}<video src="{{ copy.site.video }}" id="intro-video" controls playsinline hidden aria-label="Katya’s personal introduction"></video>{% endif %}<details class="video-preview"><summary>{{ copy.text["meet"]["summary1"] | inline | safe }}</summary><div class="prose" data-copy-markdown="true">{{ copy.prose["meet-paragraph3"] | markdown | safe }}</div><label class="button secondary">Choose video<input id="video-file" type="file" accept="video/*" hidden></label><p id="video-status" role="status"></p></details></div></div></details></section>
<section id="lab" class="preview-section"><details class="upcoming-preview"><summary><span>{{ copy.text.previews.notebook }}</span><span class="preview-status">{{ copy.text.previews.status }}</span><span class="preview-toggle" aria-hidden="true">+</span></summary><div class="preview-content"><div class="sectiontop"><div><h2>{{ copy.text["lab"]["h2_1"] | inline | safe }}</h2></div><div class="prose" data-copy-markdown="true">{{ copy.prose["lab-paragraph1"] | markdown | safe }}</div></div><div class="prose" data-copy-markdown="true" class="concept-note">{{ copy.prose["lab-paragraph2"] | markdown | safe }}</div><div class="tabs" role="tablist" aria-label="Explore the product story"><button role="tab" aria-selected="true" data-story="0">{{ copy.text["lab"]["button1"] | inline | safe }}</button><button role="tab" aria-selected="false" data-story="1">{{ copy.text["lab"]["button2"] | inline | safe }}</button><button role="tab" aria-selected="false" data-story="2">{{ copy.text["lab"]["button3"] | inline | safe }}</button><button role="tab" aria-selected="false" data-story="3">{{ copy.text["lab"]["button4"] | inline | safe }}</button></div><div id="story-panel" class="story-panel" role="tabpanel"></div><div class="story-controls"><button id="story-prev">{{ copy.text["lab"]["button5"] | inline | safe }}</button><span id="story-count" aria-live="polite">{{ copy.text["lab"]["span1"] | inline | safe }}</span><button id="story-next">{{ copy.text["lab"]["button6"] | inline | safe }}</button></div></div></details></section>
<section id="testimonials" class="preview-section"><details class="upcoming-preview"><summary><span>{{ copy.text.previews.testimonials }}</span><span class="preview-status">{{ copy.text.previews.status }}</span><span class="preview-toggle" aria-hidden="true">+</span></summary><div class="preview-content twocol"><div><h2>{{ copy.text["testimonials"]["h2_1"] | inline | safe }}</h2><div class="prose" data-copy-markdown="true">{{ copy.prose["testimonials-paragraph1"] | markdown | safe }}</div></div>{% if copy.testimonials.length %}<div>{% for item in copy.testimonials %}<blockquote class="testimonial-placeholder"><p>{{ item.quote }}</p><cite>{{ item.name }}{% if item.context %} · {{ item.context }}{% endif %}</cite></blockquote>{% endfor %}</div>{% else %}<div class="testimonial-placeholder"><span class="quote-mark" aria-hidden="true">{{ copy.text["testimonials"]["span1"] | inline | safe }}</span><h3>{{ copy.text["testimonials"]["h3_1"] | inline | safe }}</h3><div class="prose" data-copy-markdown="true">{{ copy.prose["testimonials-paragraph2"] | markdown | safe }}</div></div>{% endif %}</div></details></section>
<section class="contact" id="connect" aria-labelledby="contact-heading"><span id="collaborate" aria-hidden="true"></span><h2 id="contact-heading">{{ copy.text["connect"]["h2_1"] | inline | safe }}</h2><div class="contact-layout"><div><div class="tabs" role="tablist" aria-label="What would you like to discuss?"><button id="hiring-tab" role="tab" aria-controls="audience-panel" aria-selected="true" data-tab="0">{{ copy.text["collaborate"]["button1"] | inline | safe }}</button><button id="collaboration-tab" role="tab" aria-controls="audience-panel" aria-selected="false" tabindex="-1" data-tab="1">{{ copy.text["collaborate"]["button2"] | inline | safe }}</button></div><div id="audience-panel" class="collab-panel" role="tabpanel" aria-labelledby="hiring-tab" tabindex="0"></div></div><div class="contact-action"><div class="prose">{{ copy.prose["connect-paragraph1"] | markdown | safe }}</div><a class="button" id="contact-email" href="{{ copy.text["connect"]["link1"] }}">{{ copy.text["connect"]["a1"] | inline | safe }}</a><div class="prose contact-location">{{ copy.prose["connect-paragraph2"] | markdown | safe }}</div></div></div></section><footer><span>{{ copy.text["footer"]["span1"] | inline | safe }}</span><span>{{ copy.text["footer"]["span2"] | inline | safe }}</span></footer></main><dialog id="case-dialog"><button class="close" aria-label="Close case study">{{ copy.text["case-dialog"]["button1"] | inline | safe }}</button><div class="casebody" id="case-content"></div></dialog><dialog id="principles-dialog"><button class="close" aria-label="Close principles">{{ copy.text["principles-dialog"]["button1"] | inline | safe }}</button><h2>{{ copy.text["principles-dialog"]["h2_1"] | inline | safe }}</h2><ol id="principle-list"></ol></dialog>
<script src="./app.js" defer></script><script type="application/json" id="site-content">{{ copy.interactive | json | safe }}</script></body></html>
